# Backend environment — copy to backend/.env (never commit the real file)

NODE_ENV=production
PORT=3005

# MySQL (Hostinger staging uses the database created in hPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_hostinger_db_name
DB_USER=replace_with_hostinger_db_user
DB_PASSWORD=replace_with_hostinger_db_password

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_long_random_string
JWT_REFRESH_SECRET=generate_a_different_long_random_string
JWT_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=20d

BCRYPT_ROUNDS=12
SESSION_SECRET=generate_another_long_random_string

# Staging URL only — do not point this at production
CORS_ORIGIN=https://YOUR-STAGING-DOMAIN
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

LOG_LEVEL=info
LOG_FILE=logs/app.log

APP_NAME=Workflow LMS Staging
APP_VERSION=1.0.0

ENABLE_REWORK_HIGHLIGHT=true
ENABLE_RESUBMISSION_DEADLINE=true

# Express serves ../dist (needed when Hostinger Node.js owns the domain)
SERVE_FRONTEND=true
FRONTEND_DIR=

# Optional SSO (leave blank on staging unless you register this URL in SSO)
# SSO_JWKS_URL=
# SSO_ISSUER=
# JWT_ALGO=RS256
# AZURE_CLIENT_SECRET=

# Optional Teams webhook
# TEAMS_WEBHOOK_URL=
