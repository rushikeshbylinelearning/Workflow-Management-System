# Paste this entire file into GitHub → Settings → Environments → staging → secret BACKEND_ENV
# Replace every YOUR_* value first. This is the Hostinger VPS MySQL — never the A2 live database.

NODE_ENV=production
PORT=3005

# Same VPS as Node (recommended). Do not put the A2 phpMyAdmin host here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workflow_staging
DB_USER=workflow_stg
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

JWT_SECRET=YOUR_STAGING_JWT_SECRET
JWT_REFRESH_SECRET=YOUR_STAGING_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=20d

BCRYPT_ROUNDS=12
SESSION_SECRET=YOUR_STAGING_SESSION_SECRET

CORS_ORIGIN=https://YOUR-STAGING-DOMAIN
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

LOG_LEVEL=info
LOG_FILE=logs/app.log

APP_NAME=Workflow LMS Staging
APP_VERSION=1.0.0

ENABLE_REWORK_HIGHLIGHT=true
ENABLE_RESUBMISSION_DEADLINE=true

SERVE_FRONTEND=true
