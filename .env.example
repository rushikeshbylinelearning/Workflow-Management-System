# Frontend Environment Variables
# Copy this file to .env.development or .env.production and update with your values

# API URL - Backend server endpoint
# Development: http://localhost:3005/api
# Production: https://workflow.bylinelms.com/api
VITE_API_URL=http://localhost:3005/api

# SSO Dashboard URL (optional)
VITE_SSO_DASHBOARD_URL=https://sso.bylinelms.com/dashboard

# Build mode (development or production)
MODE=development

# Assignee dashboard: highlight tasks returned by admin for rework
VITE_ENABLE_REWORK_HIGHLIGHT=false

# Admin review: resubmission deadline when sending task back (baked in at `npm run build`)
# Must match backend ENABLE_RESUBMISSION_DEADLINE when both are enabled
VITE_ENABLE_RESUBMISSION_DEADLINE=false
