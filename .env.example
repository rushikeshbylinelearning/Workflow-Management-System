# Frontend build-time variables
# Copy to .env.local for laptop development.

# Backend API used by the Vite app (include /api)
VITE_API_URL=http://localhost:3005/api

# Optional SSO return dashboard
VITE_SSO_DASHBOARD_URL=https://sso.bylinelms.com/dashboard

VITE_ENABLE_REWORK_HIGHLIGHT=true
VITE_ENABLE_RESUBMISSION_DEADLINE=true
